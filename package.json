{
  "name": "qticket",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "kit:scan": "node scripts/scan-kit-usage.mjs",
    "kit:drift": "node scripts/check-kit-drift.mjs",
    "kit:audit": "node scripts/audit-ui-fidelity.mjs",
    "kit:states": "node scripts/kit-states.mjs",
    "kit:props": "node scripts/kit-props.mjs",
    "kit:a11y": "node scripts/kit-a11y.mjs",
    "kit:colors": "node scripts/kit-colors.mjs",
    "test": "npm run test:unit",
    "test:unit": "node --test --test-reporter=spec \"tests/!(firestore.rules).test.mjs\"",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "test:all": "npm run test:unit && npm run test:rules:emulator",
    "test:markdown": "node --test tests/markdown-editor.test.mjs",
    "test:notifications": "node --test tests/notification-navigation.test.mjs",
    "test:oauth-state": "node --test tests/oauth-state.test.mjs",
    "test:qtplus-exchange": "node --test tests/qtplus-exchange.test.mjs",
    "test:qtplus-link-model": "node --test tests/qtplus-link-model.test.mjs",
    "test:qtplus-material-view": "node --test tests/qtplus-material-view.test.mjs",
    "test:secret-box": "node --test tests/secret-box.test.mjs",
    "test:rules": "node --test tests/firestore.rules.test.mjs",
    "test:rules:emulator": "firebase --project demo-qticket emulators:exec --only firestore \"npm run test:rules\"",
    "migrate:issue-hierarchy": "node scripts/migrate-issue-hierarchy-v2.mjs",
    "migrate:calendar-time-visibility": "node scripts/backfill-calendar-time-log-visibility.mjs",
    "migrate:member-access": "node scripts/migrate-member-access.mjs",
    "migrate:image-assets": "node scripts/migrate-image-assets.mjs",
    "migrate:chat-attachments": "node scripts/migrate-chat-attachments.mjs",
    "migrate:issue-keys": "node scripts/migrate-issue-keys.mjs",
    "migrate:api-keys": "node scripts/migrate-api-keys.mjs",
    "cleanup:rate-limits": "node scripts/cleanup-rate-limits.mjs",
    "backfill:analytics-rollups": "node --env-file-if-exists=.env.local scripts/backfill-analytics-rollups.mjs",
    "backfill:project-issue-counts": "node --env-file-if-exists=.env.local scripts/backfill-project-issue-counts.mjs",
    "trim:import-metadata": "node --env-file-if-exists=.env.local scripts/trim-issue-import-metadata.mjs"
  },
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "@uiw/react-color": "^2.10.3",
    "cloudinary": "^2.10.0",
    "emoji-picker-react": "^4.19.1",
    "firebase": "^12.17.1",
    "firebase-admin": "^14.2.0",
    "framer-motion": "^12.40.0",
    "lucide-react": "^1.16.0",
    "next": "16.3.0",
    "pdfjs-dist": "^4.10.38",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "write-excel-file": "^4.1.1",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.7",
    "@babel/traverse": "^7.29.7",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "firebase-tools": "^15.23.0",
    "tailwindcss": "^4.3.3"
  }
}
